{
  "name": "bookie-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node scripts/backend-dev.mjs",
    "dev:all": "concurrently --kill-others-on-fail -n backend,frontend -c green,blue \"npm run dev:backend\" \"npm run dev\"",
    "generate:api": "openapi-generator-cli generate -i http://localhost:48763/v3/api-docs -g typescript-fetch -o src/generated/api --global-property apiDocs=false,modelDocs=false,apiTests=false,modelTests=false --additional-properties=typescriptThreePlus=true,supportsES6=true --type-mappings=date=string,DateTime=string",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "dev:tauri:ide": "node scripts/tauri-dev-ide.mjs",
    "build:tauri": "tauri build"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@openapitools/openapi-generator-cli": "^2.42.2",
    "@tauri-apps/cli": "^2.12.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "volta": {
    "node": "22.22.2"
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
