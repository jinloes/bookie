{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/generated/**/*.ts",
    "src/api/*.js",
    "src/utils/*.js",
    "src/hooks/*.js",
    "src/components/**/*.jsx",
    "src/pages/**/*.jsx",
    "src/App.jsx",
    "src/constants.js",
    "src/designTokens.js",
    "src/queryKeys.js"
  ],
  "exclude": ["src/**/*.test.js", "src/**/*.test.jsx"]
}
