# ============================================================================
# DATA STORAGE
# ============================================================================
# Location where Bookie stores its H2 database file
# Default: ~/.bookie/
BOOKIE_DATA_DIR=${user.home}/.bookie

# Database vendor: h2 (default, local file) or sqlserver (Azure SQL).
# Set this as a real environment variable: it selects the Spring profile before
# .env.local.properties is read. Any other value fails startup.
BOOKIE_DB_VENDOR=h2
# Azure SQL only. The URL must contain encrypt=true and must not trust the server certificate.
# The password is never read from the environment: store it in the macOS Keychain with
#   security add-generic-password -s com.bookie.sqlserver -a <BOOKIE_DB_USERNAME> -w
# or in Windows Credential Manager with
#   cmdkey /generic:com.bookie.sqlserver:<BOOKIE_DB_USERNAME> /user:<BOOKIE_DB_USERNAME> /pass
# (scripts/Set-BookieLocalConfig.ps1 sets everything up on Windows from 1Password).
BOOKIE_DB_URL=
BOOKIE_DB_USERNAME=

# H2 only: CONTINUOUS (default) keeps the intake engine polling all session; ON_DEMAND runs it only
# while there is work. The sqlserver vendor always uses ON_DEMAND so the database can auto-pause.
BOOKIE_INTAKE_EXECUTION_MODE=CONTINUOUS

# Global execution gate for scheduled polling, direct kickoffs, and explicit retries.
BOOKIE_INTAKE_WORKER_ENABLED=true
# Translation, parsing, and remote Outlook and OneDrive moves are enabled.
BOOKIE_INTAKE_WORKER_ALLOWED_JOB_TYPES=TRANSLATE_OUTLOOK_ID,PARSE_OUTLOOK,PARSE_RECEIPT,MOVE_OUTLOOK,MOVE_RECEIPT

# ============================================================================
# AI & LANGUAGE MODELS
# ============================================================================
# AI provider: copilot (default, GitHub Copilot SDK) or spring-ai (OpenAI via Spring AI)
# AI_PROVIDER=copilot

# Copilot SDK authentication token (copilot provider only). Leave empty to use the
# logged-in user's Copilot credentials instead.
AI_AUTH_TOKEN=

# Whether to use the currently logged-in user's Copilot credentials
# Default: true
# AI_USE_LOGGED_IN_USER=true

# Copilot CLI executable path (auto-detected if not provided)
AI_CLI_PATH=

# LLM model for email parsing and receipt OCR
# Default: claude-haiku-5.5
# AI_MODEL_VISION=claude-haiku-5.5

# LLM model for chat conversations
# Default: claude-haiku-5.5
# AI_MODEL_CHAT=claude-haiku-5.5

# LLM model for the agent
# Default: claude-haiku-5.5
# AI_MODEL_AGENT=claude-haiku-5.5

# Request timeout for LLM calls in milliseconds
# Default: 180000 (3 minutes)
# AI_REQUEST_TIMEOUT_MS=180000

# Enable tracing of tool execution events (generates verbose logs)
# Default: false
# AI_TOOLS_TRACE_EVENTS=false

# OpenAI API key (spring-ai provider only)
SPRING_AI_OPENAI_API_KEY=

# ============================================================================
# OUTLOOK INTEGRATION (Microsoft Azure)
# ============================================================================
# Azure Active Directory application (client) ID for OAuth
OUTLOOK_CLIENT_ID=

# Azure AD application secret
OUTLOOK_CLIENT_SECRET=

# Azure AD tenant ID
OUTLOOK_TENANT_ID=

# Optional base64-encoded 32-byte key used to encrypt the persisted Outlook token cache.
# Prefer leaving this empty: Bookie then keeps the key in the macOS Keychain or Windows Credential
# Manager (com.bookie.msal-token-cache:default). Machines sharing one database need the same key.
# Generate with: openssl rand -base64 32
BOOKIE_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# SECURITY & CORS
# ============================================================================
# Comma-separated list of allowed origins for CORS. Tauri on Windows uses http://tauri.localhost
# (https://tauri.localhost only when useHttpsScheme is enabled); keep it listed if you override this.
# Default: http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# ============================================================================
# TAURI DESKTOP APP
# ============================================================================
# Backend root directory (path to 'backend/' folder)
# If not set, Tauri will search up from the executable for gradlew
# Set this if installation is in a non-standard location
BOOKIE_BACKEND_ROOT=

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
# Spring Boot log level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_BOOKIE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB_CLIENT=DEBUG
